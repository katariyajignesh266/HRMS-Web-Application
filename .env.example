# Development-only defaults. Copy this file to .env and change local secrets as needed.
# ==============================================================================
# HRMS Docker Environment Configuration (.env)
# Copy this file to .env and adjust variables as needed for your local machine.
# ==============================================================================

# Project & Network Isolation
COMPOSE_PROJECT_NAME=hrms
HRMS_VOLUME_PREFIX=docker

# Configurable Host Ports (avoids collisions with other local services or parent projects)
HRMS_WEB_PORT=8000
HRMS_SOCKETIO_PORT=9000
# HRMS_MARIADB_PORT=3306

# Frappe & MariaDB Credentials
FRAPPE_SITE_NAME=hrms.localhost
MARIADB_ROOT_PASSWORD=123
FRAPPE_ADMIN_PASSWORD=admin
HRMS_SEED_BACKUP_DIR=/workspace/docker/seed

# Firebase Web configuration (safe client-side values; replace placeholders locally).
# Seed Database Backup Location (used on first-time bootstrap)
HRMS_SEED_BACKUP_DIR=/workspace/backups/seed

# Firebase Web Client Configuration (safe client-side values)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_UID_FIELD=firebase_uid

# Firebase Admin service-account JSON, server-side only. Never commit a real value.
# Firebase Admin SDK Credentials (server-side only)
# Provide either the JSON file path inside container or the JSON string:
FIREBASE_ADMIN_CREDENTIALS_FILE=
FIREBASE_ADMIN_CREDENTIALS_JSON=
FIREBASE_ADMIN_CREDENTIALS_FILE=

# Gmail SMTP placeholders for local Frappe Email Account setup.
# Use a dedicated project Gmail account with a Gmail App Password, never a personal Gmail or normal password.
# SMTP Email Configuration (used for employee invitations & notifications)
# For Gmail, generate an App Password from your Google Account security page.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-project-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER=your-project-email@gmail.com
SMTP_SENDER=
